# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

# Build the codec as C++ (default) or pure C (config.liblodepng.cpp=false).
#
config [bool] config.liblodepng.cpp ?= true

cxx.std = latest

using cxx
using c

hxx{*}: extension = h
h{*}: extension = h
cxx{*}: extension = cpp
c{*}: extension = c

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target
