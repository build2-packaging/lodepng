intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

lib{lodepng}: libul{lodepng}: {hxx cxx}{**} $impl_libs $intf_libs

libs{lodepng}: def{lodepng}: include = ($cxx.target.system == 'win32-msvc')
def{lodepng}: libul{lodepng}

# Build options.
#
# Point at this directory so sources and consumers resolve <lodepng.h>.
#
cxx.poptions =+ "-I$out_base" "-I$src_base"

if ($cxx.target.system == 'mingw32')
  cxx.loptions += -Wl,--export-all-symbols

# Export options.
#
lib{lodepng}:
{
  cxx.export.poptions = "-I$out_base" "-I$src_base"
  cxx.export.libs = $intf_libs
}

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{lodepng}: bin.lib.version = "-$version.project_id"
else
  lib{lodepng}: bin.lib.version = "-$version.major.$version.minor"

# Install into include/ (upstream include style is <lodepng.h>).
#
hxx{*}:
{
  install         = include/
  install.subdirs = true
}
